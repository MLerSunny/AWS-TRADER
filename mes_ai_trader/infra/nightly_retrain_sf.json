{
  "Comment": "Nightly retraining workflow for MES AI Trader models at 01:00 UTC",
  "StartAt": "Start Retraining Process",
  "States": {
    "Start Retraining Process": {
      "Type": "Pass",
      "Next": "Run Data Preprocessing"
    },
    "Run Data Preprocessing": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('P-11-data-preprocessing-{}', $$.Execution.StartTime)",
        "ProcessingInputs": [
          {
            "InputName": "code",
            "S3Input": {
              "S3Uri": "s3://mes-ai-trader-artifacts/processing/code/",
              "LocalPath": "/opt/ml/processing/input/code",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "preprocessed-data",
              "S3Output": {
                "S3Uri": "s3://mes-ai-trader-artifacts/processing/preprocessed-data/",
                "LocalPath": "/opt/ml/processing/output/data",
                "S3UploadMode": "EndOfJob"
              }
            }
          ]
        },
        "AppSpecification": {
          "ImageUri": "{{account}}.dkr.ecr.{{region}}.amazonaws.com/mes-trader-build:latest",
          "ContainerEntrypoint": ["python", "/opt/ml/processing/input/code/P-11-data-preprocessing.py"]
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": "ml.m5.xlarge",
            "VolumeSizeInGB": 30
          }
        },
        "RoleArn": "{{SageMakerRoleArn}}"
      },
      "Next": "Run Feature Engineering"
    },
    "Run Feature Engineering": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('P-12-feature-engineering-{}', $$.Execution.StartTime)",
        "ProcessingInputs": [
          {
            "InputName": "code",
            "S3Input": {
              "S3Uri": "s3://mes-ai-trader-artifacts/processing/code/",
              "LocalPath": "/opt/ml/processing/input/code",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          },
          {
            "InputName": "preprocessed-data",
            "S3Input": {
              "S3Uri": "s3://mes-ai-trader-artifacts/processing/preprocessed-data/",
              "LocalPath": "/opt/ml/processing/input/data",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "features",
              "S3Output": {
                "S3Uri": "s3://mes-ai-trader-artifacts/processing/features/",
                "LocalPath": "/opt/ml/processing/output/features",
                "S3UploadMode": "EndOfJob"
              }
            }
          ]
        },
        "AppSpecification": {
          "ImageUri": "{{account}}.dkr.ecr.{{region}}.amazonaws.com/mes-trader-build:latest",
          "ContainerEntrypoint": ["python", "/opt/ml/processing/input/code/P-12-feature-engineering.py"]
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": "ml.m5.xlarge",
            "VolumeSizeInGB": 30
          }
        },
        "RoleArn": "{{SageMakerRoleArn}}"
      },
      "Next": "Run Model Training"
    },
    "Run Model Training": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('P-13-model-training-{}', $$.Execution.StartTime)",
        "ProcessingInputs": [
          {
            "InputName": "code",
            "S3Input": {
              "S3Uri": "s3://mes-ai-trader-artifacts/processing/code/",
              "LocalPath": "/opt/ml/processing/input/code",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          },
          {
            "InputName": "features",
            "S3Input": {
              "S3Uri": "s3://mes-ai-trader-artifacts/processing/features/",
              "LocalPath": "/opt/ml/processing/input/features",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "models",
              "S3Output": {
                "S3Uri": "s3://mes-ai-trader-artifacts/models/",
                "LocalPath": "/opt/ml/processing/output/models",
                "S3UploadMode": "EndOfJob"
              }
            },
            {
              "OutputName": "evaluation",
              "S3Output": {
                "S3Uri": "s3://mes-ai-trader-artifacts/evaluation/",
                "LocalPath": "/opt/ml/processing/output/evaluation",
                "S3UploadMode": "EndOfJob"
              }
            }
          ]
        },
        "AppSpecification": {
          "ImageUri": "{{account}}.dkr.ecr.{{region}}.amazonaws.com/mes-trader-build:latest",
          "ContainerEntrypoint": ["python", "/opt/ml/processing/input/code/P-13-model-training.py"]
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": "ml.m5.xlarge",
            "VolumeSizeInGB": 30
          }
        },
        "RoleArn": "{{SageMakerRoleArn}}"
      },
      "Next": "Register LGBM Model"
    },
    "Register LGBM Model": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createModelPackage",
      "Parameters": {
        "ModelPackageGroupName": "MESTraderModelPackageGroup",
        "ModelPackageDescription": "LGBM model for MES AI Trader",
        "ModelApprovalStatus": "PendingManualApproval",
        "InferenceSpecification": {
          "Containers": [
            {
              "Image": "{{account}}.dkr.ecr.{{region}}.amazonaws.com/mes-trader-inference:latest",
              "ModelDataUrl.$": "States.Format('s3://mes-ai-trader-artifacts/models/lgbm/{}', $$.Execution.StartTime)"
            }
          ],
          "SupportedContentTypes": ["application/json"],
          "SupportedResponseMIMETypes": ["application/json"]
        },
        "ValidationSpecification": {
          "ValidationRole": "{{SageMakerRoleArn}}",
          "ValidationProfiles": [
            {
              "ProfileName": "validation-profile",
              "TransformJobDefinition": {
                "TransformInput": {
                  "DataSource": {
                    "S3DataSource": {
                      "S3DataType": "S3Prefix",
                      "S3Uri": "s3://mes-ai-trader-artifacts/validation-data/"
                    }
                  },
                  "ContentType": "application/json"
                },
                "TransformOutput": {
                  "S3OutputPath": "s3://mes-ai-trader-artifacts/validation-output/"
                },
                "TransformResources": {
                  "InstanceType": "ml.m5.large",
                  "InstanceCount": 1
                }
              }
            }
          ]
        },
        "ModelMetrics": {
          "ModelQuality": {
            "Statistics": {
              "S3Uri.$": "States.Format('s3://mes-ai-trader-artifacts/evaluation/lgbm-metrics-{}.json', $$.Execution.StartTime)"
            }
          }
        },
        "ModelPackageStatusDetails": {
          "ValidationStatuses": [
            {
              "Name": "NightlyRetraining",
              "Status": "Completed"
            }
          ]
        },
        "Tags": [
          {
            "Key": "ModelType",
            "Value": "LGBM"
          }
        ]
      },
      "Next": "Register TFT Model"
    },
    "Register TFT Model": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createModelPackage",
      "Parameters": {
        "ModelPackageGroupName": "MESTraderModelPackageGroup",
        "ModelPackageDescription": "TFT model for MES AI Trader",
        "ModelApprovalStatus": "PendingManualApproval",
        "InferenceSpecification": {
          "Containers": [
            {
              "Image": "{{account}}.dkr.ecr.{{region}}.amazonaws.com/mes-trader-inference:latest",
              "ModelDataUrl.$": "States.Format('s3://mes-ai-trader-artifacts/models/tft/{}', $$.Execution.StartTime)"
            }
          ],
          "SupportedContentTypes": ["application/json"],
          "SupportedResponseMIMETypes": ["application/json"]
        },
        "ValidationSpecification": {
          "ValidationRole": "{{SageMakerRoleArn}}",
          "ValidationProfiles": [
            {
              "ProfileName": "validation-profile",
              "TransformJobDefinition": {
                "TransformInput": {
                  "DataSource": {
                    "S3DataSource": {
                      "S3DataType": "S3Prefix",
                      "S3Uri": "s3://mes-ai-trader-artifacts/validation-data/"
                    }
                  },
                  "ContentType": "application/json"
                },
                "TransformOutput": {
                  "S3OutputPath": "s3://mes-ai-trader-artifacts/validation-output/"
                },
                "TransformResources": {
                  "InstanceType": "ml.m5.large",
                  "InstanceCount": 1
                }
              }
            }
          ]
        },
        "ModelMetrics": {
          "ModelQuality": {
            "Statistics": {
              "S3Uri.$": "States.Format('s3://mes-ai-trader-artifacts/evaluation/tft-metrics-{}.json', $$.Execution.StartTime)"
            }
          }
        },
        "ModelPackageStatusDetails": {
          "ValidationStatuses": [
            {
              "Name": "NightlyRetraining",
              "Status": "Completed"
            }
          ]
        },
        "Tags": [
          {
            "Key": "ModelType",
            "Value": "TFT"
          }
        ]
      },
      "Next": "Run Model Drift Detection"
    },
    "Run Model Drift Detection": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('P-21-drift-detection-{}', $$.Execution.StartTime)",
        "ProcessingInputs": [
          {
            "InputName": "code",
            "S3Input": {
              "S3Uri": "s3://mes-ai-trader-artifacts/processing/code/",
              "LocalPath": "/opt/ml/processing/input/code",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          },
          {
            "InputName": "evaluation",
            "S3Input": {
              "S3Uri": "s3://mes-ai-trader-artifacts/evaluation/",
              "LocalPath": "/opt/ml/processing/input/evaluation",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          },
          {
            "InputName": "historical-data",
            "S3Input": {
              "S3Uri": "s3://mes-ai-trader-artifacts/historical-data/",
              "LocalPath": "/opt/ml/processing/input/historical-data",
              "S3DataType": "S3Prefix",
              "S3InputMode": "File"
            }
          }
        ],
        "ProcessingOutputConfig": {
          "Outputs": [
            {
              "OutputName": "drift-metrics",
              "S3Output": {
                "S3Uri": "s3://mes-ai-trader-artifacts/drift-detection/",
                "LocalPath": "/opt/ml/processing/output/drift-metrics",
                "S3UploadMode": "EndOfJob"
              }
            }
          ]
        },
        "AppSpecification": {
          "ImageUri": "{{account}}.dkr.ecr.{{region}}.amazonaws.com/mes-trader-build:latest",
          "ContainerEntrypoint": ["python", "/opt/ml/processing/input/code/P-21-drift-detection.py"]
        },
        "ProcessingResources": {
          "ClusterConfig": {
            "InstanceCount": 1,
            "InstanceType": "ml.m5.xlarge",
            "VolumeSizeInGB": 30
          }
        },
        "RoleArn": "{{SageMakerRoleArn}}"
      },
      "Next": "Check Model Drift"
    },
    "Check Model Drift": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.DriftDetected",
          "BooleanEquals": true,
          "Next": "Alert on Model Drift"
        }
      ],
      "Default": "No Drift Detected"
    },
    "Alert on Model Drift": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "{{ModelDriftSNSTopicArn}}",
        "Message": {
          "default.$": "States.Format('Model drift detected on {} with drift score: {}', $$.Execution.StartTime, $.DriftScore)"
        },
        "Subject": "MES AI Trader - Model Drift Alert"
      },
      "Next": "Submit Model for Review"
    },
    "Submit Model for Review": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "{{SubmitModelForReviewFunctionArn}}",
        "Payload": {
          "executionTime.$": "$$.Execution.StartTime",
          "driftScore.$": "$.DriftScore",
          "lgbmMetricsUri.$": "States.Format('s3://mes-ai-trader-artifacts/evaluation/lgbm-metrics-{}.json', $$.Execution.StartTime)",
          "tftMetricsUri.$": "States.Format('s3://mes-ai-trader-artifacts/evaluation/tft-metrics-{}.json', $$.Execution.StartTime)",
          "driftUri.$": "States.Format('s3://mes-ai-trader-artifacts/drift-detection/drift-metrics-{}.json', $$.Execution.StartTime)"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "No Drift Detected": {
      "Type": "Pass",
      "Result": {
        "message": "No model drift detected, continuing with current model."
      },
      "End": true
    }
  }
} 